# ============================================================================
# Indes Portal — environment template
# Copy this file to .env and fill in real values. NEVER commit .env.
#   PowerShell:  Copy-Item .env.example .env
# ============================================================================

# --- Django -----------------------------------------------------------------
DEBUG=True
SECRET_KEY=change-me-generate-a-long-random-value
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (production runs PostgreSQL) ----------------------------------
DB_NAME=ong_platform
DB_USER=ong_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# --- Email ------------------------------------------------------------------
# Development: print emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Production example:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=noreply@example.com
# EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=noreply@example.com

# --- Resend (email delivery) ------------------------------------------------
# Add your own key locally; keys must never be committed.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@example.com

# --- Course area integration ------------------------------------------------
COURSE_AREA_BASE_URL=http://localhost:7000

# --- Verification / reset token lifetime (minutes) ---------------------------
EMAIL_VERIFICATION_EXPIRY=10
PASSWORD_RESET_EXPIRY_MINUTES=10

# --- Payments (disabled in this build — routes exist but are not promoted) ---
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=